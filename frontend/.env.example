# Copier vers .env.local et renseigner vos valeurs.
# Ne jamais committer .env.local ni de vraies clés.

# --- Obligatoire (Supabase) ---
# Clés publiques côté client (anon). Jamais la service_role ici.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Local / Native Helper ---
VITE_WEBSOCKET_URL=ws://localhost:8765

# --- Admin (optionnel) ---
# UUID Supabase Auth de l'admin. Pas de valeur par défaut dans le code.
VITE_ADMIN_UUID=

# --- APIs optionnelles (tout VITE_* est dans le bundle navigateur) ---
# Gemini : secret Edge Function GEMINI_API_KEY uniquement — PAS de VITE_GEMINI_*.
VITE_PEXELS_API_KEY=
VITE_PIXABAY_API_KEY=
VITE_FREESOUND_API_KEY=
VITE_FREESOUND_CLIENT_ID=
# Ne jamais mettre FREESOUND_CLIENT_SECRET en VITE_* (bundle navigateur).
#
# Edge secrets (dashboard Supabase, pas ici) :
# GEMINI_API_KEY, CORS_ALLOWED_ORIGINS, RESEND_API_KEY, CONTACT_EMAIL, RESEND_FROM_EMAIL

# Packaging Native Helper (optionnel)
# VITE_GITHUB_REPO=Probe311/WebAmp
# VITE_NATIVE_HELPER_VERSION=latest
